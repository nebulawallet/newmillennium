{
  "name": "new-millennium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "New Millennium: a modern-day grand strategy game (2000 onward) built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-map": "tsx scripts/map/fetch.ts",
    "fetch-worldbank": "tsx scripts/data/fetch-worldbank.ts",
    "build-map": "tsx scripts/map/build.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "review-report": "tsx scripts/review-report.ts",
    "gen-schemas": "tsx scripts/gen-schemas.ts",
    "content-stats": "tsx scripts/content-stats.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run validate-data -- --existing --tier core"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "d3-delaunay": "^6.0.4",
    "earcut": "^3.2.4",
    "mapshaper": "^0.7.85",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "preact": "^11.0.1",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5",
    "zod": "^4.6.7"
  }
}
