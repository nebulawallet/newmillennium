{
  "name": "new-millennium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "New Millennium: a modern-day grand strategy game (2000 onward) built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate-data": "tsx scripts/validate-data.ts",
    "review-report": "tsx scripts/review-report.ts",
    "gen-schemas": "tsx scripts/gen-schemas.ts",
    "content-stats": "tsx scripts/content-stats.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run validate-data -- --existing --tier full"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "preact": "^11.0.1",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5",
    "zod": "^4.6.7"
  }
}
