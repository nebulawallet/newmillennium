{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "trigger": {},
          "historical": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Calendar date, YYYY-MM-DD"
              },
              "any_path": {
                "default": false,
                "type": "boolean"
              },
              "dynamic_mode": {
                "default": false,
                "type": "boolean"
              },
              "source": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "accessed": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                      "description": "Calendar date, YYYY-MM-DD"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "title",
                    "accessed"
                  ],
                  "additionalProperties": false
                }
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "verified",
                  "needs_review"
                ]
              },
              "review_note": {
                "type": "string"
              }
            },
            "required": [
              "date",
              "source",
              "confidence"
            ],
            "additionalProperties": false
          },
          "mean_days": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "triggered_only": {
            "default": false,
            "type": "boolean"
          },
          "fire_only_once": {
            "default": true,
            "type": "boolean"
          },
          "major": {
            "default": false,
            "type": "boolean"
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {},
                "ai_weight": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0
                },
                "effects": {
                  "default": [],
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false
}
