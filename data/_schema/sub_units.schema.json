{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sub_units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "battalion",
              "support"
            ]
          },
          "manpower": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "equipment": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "organisation": {
            "default": 30,
            "type": "number"
          },
          "hp": {
            "default": 2,
            "type": "number"
          },
          "width": {
            "default": 2,
            "type": "number"
          },
          "speed": {
            "default": 4,
            "type": "number"
          },
          "follows_line": {
            "default": false,
            "type": "boolean"
          },
          "training_days": {
            "default": 90,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "kind",
          "manpower",
          "equipment"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "sub_units"
  ],
  "additionalProperties": false
}
