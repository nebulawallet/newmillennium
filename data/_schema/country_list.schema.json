{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string"
          },
          "short_name": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "europe",
              "former_ussr",
              "north_america",
              "latam_caribbean",
              "mena",
              "subsaharan_africa",
              "south_asia",
              "east_se_asia",
              "oceania"
            ]
          },
          "start_status": {
            "type": "string",
            "enum": [
              "independent",
              "de_facto",
              "un_administered",
              "rival_government",
              "insurgent",
              "releasable"
            ]
          },
          "un_member_2000": {
            "type": "boolean"
          },
          "un_member_today": {
            "type": "boolean"
          },
          "detail_tier": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "research": {
            "default": "default",
            "type": "string",
            "enum": [
              "full",
              "light",
              "default"
            ]
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "tag",
          "name",
          "region",
          "start_status",
          "un_member_2000",
          "un_member_today",
          "detail_tier"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "as_of",
    "countries"
  ],
  "additionalProperties": false
}
