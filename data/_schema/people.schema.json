{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{3}\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "native": {
                "type": "string",
                "minLength": 1
              },
              "native_latin": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "birth_year": {
            "type": "integer",
            "minimum": 1880,
            "maximum": 2010
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD"
          },
          "died": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "party": {
            "type": "string",
            "pattern": "^[a-z]{3}\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "party_history": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "party": {
                  "type": "string",
                  "pattern": "^[a-z]{3}\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
                },
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                      "description": "Calendar date, YYYY-MM-DD"
                    },
                    {
                      "type": "integer",
                      "minimum": 1500,
                      "maximum": 2100
                    }
                  ]
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                      "description": "Calendar date, YYYY-MM-DD"
                    },
                    {
                      "type": "integer",
                      "minimum": 1500,
                      "maximum": 2100
                    }
                  ]
                }
              },
              "required": [
                "party",
                "from"
              ],
              "additionalProperties": false
            }
          },
          "sub_ideology": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "traits": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "roles_possible": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "head_of_state",
                "head_of_government",
                "presidential_candidate",
                "opposition_leader",
                "party_leader",
                "faction_leader",
                "foreign_minister",
                "defence_minister",
                "finance_minister",
                "interior_minister",
                "economy_minister",
                "justice_minister",
                "energy_minister",
                "intelligence_chief",
                "army_chief",
                "navy_chief",
                "air_chief",
                "chief_of_staff",
                "monarch",
                "heir",
                "religious_leader",
                "insurgent_leader",
                "interest_group_leader"
              ]
            }
          },
          "available": {
            "default": {},
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Calendar date, YYYY-MM-DD"
              },
              "to": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Calendar date, YYYY-MM-DD"
              }
            },
            "additionalProperties": false
          },
          "electoral_appeal": {
            "default": 50,
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "military": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "enum": [
                  "army",
                  "navy",
                  "air",
                  "joint",
                  "marines",
                  "intelligence"
                ]
              },
              "rank": {
                "type": "string"
              }
            },
            "required": [
              "branch",
              "rank"
            ],
            "additionalProperties": false
          },
          "generated": {
            "type": "boolean"
          },
          "bio": {
            "type": "string",
            "maxLength": 400
          },
          "note": {
            "type": "string"
          },
          "source": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "Calendar date, YYYY-MM-DD"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "title",
                "accessed"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "verified",
              "needs_review"
            ]
          },
          "review_note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "gender",
          "birth_year",
          "country",
          "sub_ideology",
          "roles_possible",
          "source",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "people"
  ],
  "additionalProperties": false
}
