{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "level": {
            "type": "string",
            "enum": [
              "province",
              "national"
            ]
          },
          "max_per_province": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "adds": {
            "type": "object",
            "properties": {
              "infrastructure": {
                "type": "number"
              },
              "civilian_factories": {
                "type": "number"
              },
              "military_factories": {
                "type": "number"
              },
              "growth": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "cost",
          "level",
          "adds"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "buildings"
  ],
  "additionalProperties": false
}
